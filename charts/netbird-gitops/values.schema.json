{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "netbird-gitops values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "httpUrl": { "type": "string", "pattern": "^https?://" },
    "duration": {
      "description": "A duration such as 48h, 7d or 1h30m, or false to disable.",
      "oneOf": [
        { "type": "string", "pattern": "^([0-9]+[smhd])+$" },
        { "const": false }
      ]
    },
    "groupName": { "type": "string", "minLength": 1, "not": { "pattern": "^(gitops-|All$)" } },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "k8sObject": { "type": "object" },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address"],
      "properties": {
        "address": {
          "type": "string",
          "description": "Domain, *.domain, IP or CIDR.",
          "pattern": "^((\\*\\.)?([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z]{2,63}|[0-9]{1,3}(\\.[0-9]{1,3}){3}(/[0-9]{1,2})?|[0-9A-Fa-f:]*:[0-9A-Fa-f:]*(/[0-9]{1,3})?)$"
        },
        "protocol": { "enum": ["tcp", "udp", "icmp", "all"], "default": "tcp" },
        "ports": {
          "description": "Defaults to [443]. None for icmp and all.",
          "oneOf": [
            { "$ref": "#/definitions/port" },
            { "type": "array", "items": { "$ref": "#/definitions/port" }, "minItems": 1, "uniqueItems": true }
          ]
        },
        "title": { "type": "string", "description": "Portal card title. Defaults to the name." },
        "description": { "type": "string" },
        "url": { "$ref": "#/definitions/httpUrl", "description": "Card link. Defaults to https://<address> for a domain on tcp/443." },
        "probe": { "$ref": "#/definitions/httpUrl", "description": "URL the portal requests to check access." },
        "icon": { "enum": ["globe", "chart", "activity", "bell", "search", "git", "database", "terminal", "server", "lock", "book", "box"] },
        "showInPortal": { "type": "boolean", "default": true }
      }
    }
  },
  "properties": {
    "global": { "type": "object" },
    "access": {
      "description": "Who can reach what: group -> resource names, or [\"*\"] for every resource.",
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/groupName" },
      "additionalProperties": {
        "type": ["array", "null"],
        "items": { "type": "string", "pattern": "^(\\*|[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)$" },
        "uniqueItems": true
      }
    },
    "resources": {
      "description": "What can be reached: name -> resource.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$", "not": { "const": "portal" } },
      "additionalProperties": { "$ref": "#/definitions/resource" }
    },
    "members": {
      "description": "e-mail -> groups. null: membership is managed in the NetBird console.",
      "type": ["object", "null"],
      "propertyNames": { "pattern": "^[^@\\s]+@[^@\\s]+$" },
      "additionalProperties": { "type": ["array", "null"], "items": { "type": "string" }, "uniqueItems": true }
    },
    "consoleAdmins": { "type": "string", "description": "Group whose members get the console role admin." },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "restrictRegularUsers": { "type": "boolean" },
        "groupsPropagation": { "type": "boolean" },
        "userApproval": { "type": "boolean" },
        "peerApproval": { "type": "boolean" },
        "peerLoginExpiration": { "$ref": "#/definitions/duration" },
        "peerInactivityExpiration": { "$ref": "#/definitions/duration" },
        "raw": { "type": "object", "description": "Other AccountSettings fields, by NetBird API name." }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "routerGroup": { "type": "string" },
        "masquerade": { "type": "boolean" },
        "metric": { "type": "integer", "minimum": 1, "maximum": 9999 }
      }
    },
    "netbird": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "apiUrl": { "type": "string" },
        "tokenSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "name": { "type": "string" }, "key": { "type": "string" } }
        }
      }
    },
    "reconciler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "schedule": { "type": "string" },
        "dryRun": { "type": "boolean" },
        "strict": { "type": "boolean" },
        "disableAllToAll": { "type": "boolean" },
        "approveMembers": { "type": "boolean" },
        "checkRouterOnline": { "type": "boolean" },
        "suspend": { "type": "boolean" },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "successfulJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "failedJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "resources": { "$ref": "#/definitions/k8sObject" },
        "podAnnotations": { "$ref": "#/definitions/k8sObject" },
        "nodeSelector": { "$ref": "#/definitions/k8sObject" },
        "tolerations": { "type": "array" },
        "affinity": { "$ref": "#/definitions/k8sObject" }
      }
    },
    "image": { "$ref": "#/definitions/image" },
    "imagePullSecrets": { "type": "array" },
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "address": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "lang": { "type": "string" },
        "logo": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "svg": { "type": "string" }, "alt": { "type": "string" } }
        },
        "font": { "enum": ["inter", "system"] },
        "checkTimeoutMs": { "type": "integer", "minimum": 500 },
        "text": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "searchLabel": { "type": "string" },
            "searchPlaceholder": { "type": "string" },
            "checking": { "type": "string" },
            "available": { "type": "string" },
            "availableOne": { "type": "string" },
            "matching": { "type": "string" },
            "noneTitle": { "type": "string" },
            "noneBody": { "type": "string" },
            "noMatchTitle": { "type": "string" },
            "noMatchBody": { "type": "string" },
            "clear": { "type": "string" },
            "recheck": { "type": "string" },
            "copy": { "type": "string" },
            "copied": { "type": "string" },
            "noScript": { "type": "string" },
            "footer": { "type": "string" }
          }
        },
        "image": { "$ref": "#/definitions/image" },
        "replicas": { "type": "integer", "minimum": 0 },
        "resources": { "$ref": "#/definitions/k8sObject" },
        "podAnnotations": { "$ref": "#/definitions/k8sObject" },
        "nodeSelector": { "$ref": "#/definitions/k8sObject" },
        "tolerations": { "type": "array" },
        "affinity": { "$ref": "#/definitions/k8sObject" },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "port": { "$ref": "#/definitions/port" }
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "className": { "type": "string" },
            "annotations": { "type": "object" },
            "host": { "type": "string" },
            "tls": { "type": "array" }
          }
        }
      }
    }
  }
}
